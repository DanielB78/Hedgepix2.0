# Public Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BARGO_API_KEY=fak_your_optional_bargo_key

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_URL is provided automatically in Edge Functions
# SUPABASE_SERVICE_ROLE_KEY
# BARGO_API_KEY
