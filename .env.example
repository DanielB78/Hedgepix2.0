# Public Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used by the Next.js server to read sync status (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Alpaca Market Data (IEX daily bars). Never expose to the browser.
# Also set these in backend/.env so `update.bat` / `npm run update-data` can sync prices.
ALPACA_API_KEY=your-alpaca-key-id
ALPACA_API_SECRET=your-alpaca-secret-key

# Backend updater credentials live in backend/.env — see backend/.env.example
