# Server-only secrets — never commit real values; never expose to the frontend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alpaca Market Data (IEX daily bars). Optional — trades still sync if unset.
ALPACA_API_KEY=your-alpaca-key-id
ALPACA_API_SECRET=your-alpaca-secret-key

# InsiderWatch ongoing updater (npm run update-data)
# INSIDERWATCH_CSV_URL=https://insiderwatch.ai/api/data/congress-trades.csv
# INSIDERWATCH_CSV_PATH=/path/to/local.csv
INSIDERWATCH_OVERLAP_DAYS=3
INSIDERWATCH_INITIAL_DAYS=14

# Optional: local checkout of https://github.com/kadoa-org/congress-trading-monitor
# (repo root or public/data). When unset, backfill-kadoa clones into backend/.cache/
# KADOA_DATA_DIR=/path/to/congress-trading-monitor
# KADOA_REFRESH=1
