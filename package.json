{
  "name": "congress-trade-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "update-data": "npm run update-data --prefix backend",
    "backfill-kadoa": "npm run backfill-kadoa --prefix backend",
    "backfill-ceo-buys": "npm run backfill-ceo-buys --prefix backend",
    "backfill-13f": "npm run backfill-13f --prefix backend",
    "backfill-sec-ownership": "npm run backfill-sec-ownership --prefix backend",
    "backfill-form144": "npm run backfill-form144 --prefix backend",
    "backfill-company-filings": "npm run backfill-company-filings --prefix backend",
    "backfill-nport": "npm run backfill-nport --prefix backend",
    "apply-sec-schema": "npm run apply-sec-schema --prefix backend",
    "sync:prices": "node --env-file=.env.local scripts/sync-stock-prices.mjs",
    "purge:pre2024-prices": "node --env-file=.env.local scripts/purge-pre2024-prices.mjs",
    "purge:pre2026-data": "node --env-file=.env.local scripts/purge-pre2026-data.mjs",
    "test:prices": "node scripts/lib/equity-tickers.test.mjs && node scripts/lib/sync-stock-prices.test.mjs && node scripts/lib/compute-holdings.test.mjs",
    "test:performers": "npx --yes tsx scripts/lib/top-performers.test.mjs",
    "repair:ceo-codes": "node --env-file=.env.local scripts/repair-ceo-transaction-codes.mjs",
    "local:db:install": "bash scripts/local-db/install-postgrest.sh",
    "local:db:bootstrap": "bash scripts/local-db/bootstrap.sh",
    "local:db:migrate": "bash scripts/local-db/migrate.sh",
    "local:db:start": "bash scripts/local-db/start.sh",
    "local:db:stop": "bash scripts/local-db/stop.sh",
    "local:db:status": "bash scripts/local-db/status.sh",
    "local:db:seed": "sudo -u postgres psql -d hedgpix -f scripts/local-db/seed-demo.sql",
    "local:dev": "bash scripts/local-db/run-next.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.45.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
